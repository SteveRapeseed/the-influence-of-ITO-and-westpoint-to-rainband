def normalize_coords(da: xr.DataArray) -> xr.DataArray:
    rename = {}
    if "latitude" in da.dims:
        rename["latitude"] = "lat"
    if "longitude" in da.dims:
        rename["longitude"] = "lon"
    if rename:
        da = da.rename(rename)
    if "lon" not in da.coords or "lat" not in da.coords:
        raise ValueError(f"{da.name!r} has no recognized latitude/longitude axes.")
    lon = da["lon"].values
    if np.nanmin(lon) < 0:
        da = da.assign_coords(lon=np.mod(lon, 360.0))
    return da.sortby("lon")


def load_jja_anomalies(
    path: Path,
    variable: str,
    year_start: int,
    year_end: int,
    clim_start: int,
    clim_end: int,
    level: float | None = None,
) -> tuple[xr.DataArray, xr.DataArray]:
    """Return annual JJA anomalies and the reference-period JJA climatology."""
    with xr.open_dataset(path, decode_times=True) as ds:
        da = ds[variable]
        if level is not None:
            da = da.sel(level=level)
        da = normalize_coords(da)
        year_mask = (da.time.dt.year >= year_start) & (da.time.dt.year <= year_end)
        da = da.where(year_mask, drop=True)
        jja = da.where(da.time.dt.month.isin(JJA_MONTHS), drop=True)

        month_days = xr.DataArray(
            jja.time.dt.days_in_month.astype("float64").values,
            dims=("time",),
            coords={"time": jja.time},
        )
        weighted_sum = (jja * month_days).groupby("time.year").sum(
            "time", skipna=True
        )
        valid_days = (xr.ones_like(jja, dtype="float64") * month_days).where(
            jja.notnull()
        )
        denominator = valid_days.groupby("time.year").sum("time", skipna=True)
        annual = (weighted_sum / denominator).load()

    climatology_years = annual.sel(year=slice(clim_start, clim_end))
    if climatology_years.sizes.get("year", 0) == 0:
        raise ValueError(f"No reference years {clim_start}-{clim_end} in {path.name}.")
    climatology = climatology_years.mean("year", skipna=True)
    anomalies = (annual - climatology).load()
    return anomalies, climatology.load()


def warm_years_from_index(
    data_dir: Path,
    year_start: int,
    year_end: int,
    threshold: float,
) -> tuple[list[int], pd.DataFrame]:
    index = pd.read_csv(data_dir / "TIO_JJA.csv")
    required = {"year", "TIO_JJA_std"}
    missing = required.difference(index.columns)
    if missing:
        raise ValueError(f"TIO_JJA.csv is missing columns: {sorted(missing)}")
    index["year"] = pd.to_numeric(index["year"], errors="coerce")
    index["TIO_JJA_std"] = pd.to_numeric(index["TIO_JJA_std"], errors="coerce")
    eligible = index["year"].between(year_start, year_end)
    warm = index.loc[eligible & (index["TIO_JJA_std"] > threshold)].copy()
    years = sorted(warm["year"].astype(int).unique().tolist())
    if not years:
        raise ValueError("The warm-year threshold selected no years.")
    warm.attrs["threshold_sigma"] = threshold
    return years, warm.sort_values("year")


def require_years(da: xr.DataArray, years: list[int], label: str) -> xr.DataArray:
    available = set(np.asarray(da["year"].values, dtype=int).tolist())
    missing = sorted(set(years).difference(available))
    if missing:
        raise ValueError(f"{label} is missing requested warm years: {missing}")
    return da.sel(year=years)


def composite(da: xr.DataArray, years: list[int]) -> xr.DataArray:
    return require_years(da, years, str(da.name)).mean("year", skipna=True)


def stack_p_values(stack: xr.DataArray, dim: str = "warm_year") -> xr.DataArray:
    test = ttest_1samp(
        stack.values,
        popmean=0.0,
        axis=stack.get_axis_num(dim),
        nan_policy="omit",
    )
    dims = tuple(d for d in stack.dims if d != dim)
    coords = {d: stack[d] for d in dims}
    p = np.asarray(test.pvalue)
    p[~np.isfinite(p)] = 1.0
    return xr.DataArray(p, dims=dims, coords=coords, name="p_value")


def add_significance_dots(
    ax,
    p_values: xr.DataArray,
    extent: tuple[float, float, float, float],
    stride: int = 2,
) -> None:
    lon_min, lon_max, lat_min, lat_max = extent
    p_map = p_values.where(
        (p_values.lon >= lon_min)
        & (p_values.lon <= lon_max)
        & (p_values.lat >= lat_min)
        & (p_values.lat <= lat_max),
        drop=True,
    )
    if p_map.sizes.get("lat", 0) == 0 or p_map.sizes.get("lon", 0) == 0:
        return
    p_map = p_map.isel(lat=slice(None, None, stride), lon=slice(None, None, stride))
    yy, xx = np.where(p_map.values < 0.05)
    if len(xx):
        ax.scatter(
            p_map.lon.values[xx],
            p_map.lat.values[yy],
            s=1.0,
            marker=".",
            color="#202020",
            alpha=0.58,
            linewidths=0,
            transform=PROJECTION,
            zorder=7,
        )


def subset_region(
    da: xr.DataArray, extent: tuple[float, float, float, float]
) -> xr.DataArray:
    lon_min, lon_max, lat_min, lat_max = extent
    return da.where(
        (da.lon >= lon_min)
        & (da.lon <= lon_max)
        & (da.lat >= lat_min)
        & (da.lat <= lat_max),
        drop=True,
    )


def area_weighted_mean(
    da: xr.DataArray, region: tuple[float, float, float, float]
) -> float:
    lon_min, lon_max, lat_min, lat_max = region
    sub = da.where(
        (da.lon >= lon_min)
        & (da.lon <= lon_max)
        & (da.lat >= lat_min)
        & (da.lat <= lat_max),
        drop=True,
    )
    weights = np.cos(np.deg2rad(sub.lat))
    return float(sub.weighted(weights).mean(("lat", "lon"), skipna=True).values)


def zonal_mean_equatorial(da: xr.DataArray) -> xr.DataArray:
    mask = (da.lat >= -5.0) & (da.lat <= 5.0)
    eq = da.where(mask, drop=True)
    if eq.sizes.get("lat", 0) == 0:
        raise ValueError("No latitude cells fall within 5°S-5°N.")
    weights = np.cos(np.deg2rad(eq.lat))
    return eq.weighted(weights).mean("lat", skipna=True)


def vector_diagnostics(
    u_annual: xr.DataArray,
    v_annual: xr.DataArray,
    years: list[int],
    diagnostics: tuple[str, ...],
) -> dict[str, xr.DataArray]:
    """Compute spherical-harmonic wind diagnostics for each warm year."""
    results: dict[str, list[xr.DataArray]] = {name: [] for name in diagnostics}
    for year in years:
        u = u_annual.sel(year=year, drop=True).transpose("lat", "lon")
        v = v_annual.sel(year=year, drop=True).transpose("lat", "lon")
        wind = VectorWind(u, v, gridtype="regular")
        for name in diagnostics:
            if name == "chi":
                value = wind.velocitypotential()
            elif name == "psi":
                value = wind.streamfunction()
            elif name == "divergence":
                value = wind.divergence()
            elif name == "divergent_wind":
                value = wind.irrotationalcomponent()
            elif name == "rotational_wind":
                value = wind.nondivergentcomponent()
            else:
                raise ValueError(f"Unknown vector diagnostic: {name}")
            if isinstance(value, tuple):
                results[name].append(xr.concat(value, dim="component"))
            else:
                results[name].append(value)
    output = {}
    for name, values in results.items():
        stack = xr.concat(
            values,
            dim=xr.IndexVariable("warm_year", np.asarray(years, dtype=int)),
        ).load()
        output[name] = stack
    return output


def confidence_interval(values: np.ndarray) -> tuple[np.ndarray, np.ndarray, np.ndarray]:
    n = values.shape[0]
    mean = np.nanmean(values, axis=0)
    spread = np.nanstd(values, axis=0, ddof=1)
    margin = t.ppf(0.975, n - 1) * spread / np.sqrt(n)
    return mean, mean - margin, mean + margin


