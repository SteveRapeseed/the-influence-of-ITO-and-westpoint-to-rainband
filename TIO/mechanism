def stack_field(
    annual: xr.DataArray, years: list[int], name: str
) -> xr.DataArray:
    field = require_years(annual, years, name).rename({"year": "warm_year"})
    return field.assign_coords(warm_year=np.asarray(years, dtype=int))


def west_edge_longitude(
    field: xr.DataArray,
    threshold: float = 5880.0,
    lat_range: tuple[float, float] = (10.0, 30.0),
    lon_range: tuple[float, float] = (80.0, 180.0),
) -> float:
    subset = field.where(
        (field.lat >= lat_range[0])
        & (field.lat <= lat_range[1])
        & (field.lon >= lon_range[0])
        & (field.lon <= lon_range[1]),
        drop=True,
    )
    lon = subset.lon.values.astype(float)
    estimates = []
    weights = []
    for lat_value, row in zip(subset.lat.values, subset.values):
        finite = np.isfinite(row)
        if finite.sum() < 2:
            continue
        row = row[finite]
        x = lon[finite]
        crossings = []
        if row[0] >= threshold:
            crossings.append(float(x[0]))
        else:
            for i in range(len(row) - 1):
                if row[i] < threshold <= row[i + 1]:
                    fraction = (threshold - row[i]) / (row[i + 1] - row[i])
                    crossings.append(float(x[i] + fraction * (x[i + 1] - x[i])))
        if crossings:
            estimates.append(min(crossings))
            weights.append(np.cos(np.deg2rad(lat_value)))
    if not estimates:
        return float("nan")
    return float(np.average(estimates, weights=weights))


def run_vector_diagnostics(
    data_dir: Path,
    warm_years: list[int],
    year_start: int,
    year_end: int,
    clim_start: int,
    clim_end: int,
) -> dict[str, xr.DataArray]:
    output: dict[str, xr.DataArray] = {}
    for level, prefix in ((200.0, "200"), (850.0, "850")):
        u, _ = load_jja_anomalies(
            data_dir / "ncep.uwnd.mon.mean.nc",
            "uwnd",
            year_start,
            year_end,
            clim_start,
            clim_end,
            level,
        )
        v, _ = load_jja_anomalies(
            data_dir / "ncep.vwnd.mon.mean.nc",
            "vwnd",
            year_start,
            year_end,
            clim_start,
            clim_end,
            level,
        )
        u = require_years(u, warm_years, f"u{prefix}")
        v = require_years(v, warm_years, f"v{prefix}")
        output[f"u{prefix}_annual"] = u
        output[f"v{prefix}_annual"] = v
        if prefix == "200":
            diagnostics = vector_diagnostics(
                u, v, warm_years, ("chi", "divergent_wind")
            )
            output["chi_stack"] = diagnostics["chi"]
            output["divergent_wind_stack"] = diagnostics["divergent_wind"]
        else:
            diagnostics = vector_diagnostics(
                u, v, warm_years, ("psi", "divergence", "rotational_wind")
            )
            output["psi_stack"] = diagnostics["psi"]
            output["div850_stack"] = diagnostics["divergence"]
            output["rotational_wind_stack"] = diagnostics["rotational_wind"]
    return output


def make_products(
    data_dir: Path,
    output_dir: Path,
    warm_years: list[int],
    warm_index: pd.DataFrame,
    data: dict[str, xr.DataArray],
    years: tuple[int, int],
    climatology_years: tuple[int, int],
) -> dict[str, object]:
    start, end = years
    clim_start, clim_end = climatology_years

    sst, sst_clim = load_jja_anomalies(
        data_dir / "HadISST_sst.nc",
        "sst",
        start,
        end,
        clim_start,
        clim_end,
    )
    olr, _ = load_jja_anomalies(
        data_dir / "noaa.olr.mon.mean.nc",
        "olr",
        start,
        end,
        clim_start,
        clim_end,
    )
    hgt, hgt_clim = load_jja_anomalies(
        data_dir / "ncep.hgt.mon.mean.nc",
        "hgt",
        start,
        end,
        clim_start,
        clim_end,
        level=500.0,
    )
    for label, annual in (("SST", sst), ("OLR", olr), ("HGT500", hgt)):
        require_years(annual, warm_years, label)

    sst_stack = stack_field(sst, warm_years, "SST")
    olr_stack = stack_field(olr, warm_years, "OLR")
    hgt_stack = stack_field(hgt, warm_years, "HGT500")

    chi_stack = data["chi_stack"]
    psi_stack = data["psi_stack"]
    div_stack = data["div850_stack"]
    div_wind_stack = data["divergent_wind_stack"]
    rot_wind_stack = data["rotational_wind_stack"]

    fields = {
        "sst": sst_stack.mean("warm_year", skipna=True),
        "olr": olr_stack.mean("warm_year", skipna=True),
        "hgt": hgt_stack.mean("warm_year", skipna=True),
        "chi": chi_stack.mean("warm_year", skipna=True),
        "psi": psi_stack.mean("warm_year", skipna=True),
        "div850": div_stack.mean("warm_year", skipna=True),
        "divergent_u200": div_wind_stack.sel(component=0).mean(
            "warm_year", skipna=True
        ),
        "divergent_v200": div_wind_stack.sel(component=1).mean(
            "warm_year", skipna=True
        ),
        "rotational_u850": rot_wind_stack.sel(component=0).mean(
            "warm_year", skipna=True
        ),
        "rotational_v850": rot_wind_stack.sel(component=1).mean(
            "warm_year", skipna=True
        ),
        "u850": data["u850_annual"].mean("year", skipna=True),
        "v850": data["v850_annual"].mean("year", skipna=True),
        "u200": data["u200_annual"].mean("year", skipna=True),
        "u850_annual": data["u850_annual"],
        "u200_annual": data["u200_annual"],
        "hgt_clim": hgt_clim,
    }
    p_fields = {
        "sst": stack_p_values(sst_stack),
        "olr": stack_p_values(olr_stack),
        "hgt": stack_p_values(hgt_stack),
        "chi": stack_p_values(chi_stack),
        "psi": stack_p_values(psi_stack),
        "div850": stack_p_values(div_stack),
    }

    hgt_abs_warm = fields["hgt_clim"] + fields["hgt"]
    west_clim = west_edge_longitude(fields["hgt_clim"])
    west_warm = west_edge_longitude(hgt_abs_warm)

    profile200_yearly = zonal_mean_equatorial(data["u200_annual"])
    profile850_yearly = zonal_mean_equatorial(data["u850_annual"])
    profile200 = require_years(profile200_yearly, warm_years, "equatorial u200")
    profile850 = require_years(profile850_yearly, warm_years, "equatorial u850")
    profile200_mean = profile200.mean("year", skipna=True)
    profile850_mean = profile850.mean("year", skipna=True)
    baroclinic_yearly = profile200 - profile850
    wp_baroclinic_by_year = baroclinic_yearly.sel(lon=slice(*WEST_PACIFIC)).mean(
        "lon", skipna=True
    )
    wp_baroclinic_mean = float(wp_baroclinic_by_year.mean("year").values)
    wp_baroclinic_p = float(
        ttest_1samp(wp_baroclinic_by_year.values, 0.0, nan_policy="omit").pvalue
    )
    u200_wp = float(profile200_mean.sel(lon=slice(*WEST_PACIFIC)).mean("lon").values)
    u850_wp = float(profile850_mean.sel(lon=slice(*WEST_PACIFIC)).mean("lon").values)

    summary = {
        "period_start": start,
        "period_end": end,
        "climatology_start": clim_start,
        "climatology_end": clim_end,
        "warm_threshold_sigma": float(warm_index.attrs.get("threshold_sigma", np.nan)),
        "n_warm_years": len(warm_years),
        "warm_years": ",".join(str(y) for y in warm_years),
        "tio_sst_warm_composite_c": area_weighted_mean(fields["sst"], TIO_REGION),
        "olr_tio_warm_composite_w_m2": area_weighted_mean(
            fields["olr"], TIO_REGION
        ),
        "olr_wnpac_warm_composite_w_m2": area_weighted_mean(
            fields["olr"], WNPAC_REGION
        ),
        "chi200_tio_mean_m2_s": area_weighted_mean(fields["chi"], TIO_REGION),
        "chi200_west_pacific_mean_m2_s": area_weighted_mean(
            fields["chi"], WNPAC_REGION
        ),
        "psi850_wnpac_mean_m2_s": area_weighted_mean(fields["psi"], WNPAC_REGION),
        "div850_wnpac_mean_s-1": area_weighted_mean(
            fields["div850"], WNPAC_REGION
        ),
        "u200_west_pacific_equatorial_m_s": u200_wp,
        "u850_west_pacific_equatorial_m_s": u850_wp,
        "u200_minus_u850_west_pacific_m_s": wp_baroclinic_mean,
        "u200_minus_u850_one_sample_p": wp_baroclinic_p,
        "hgt500_west_edge_climatology_deg_e": west_clim,
        "hgt500_west_edge_warm_deg_e": west_warm,
        "hgt500_5880_geometric_shift_deg_e": west_warm - west_clim,
    }
    output_dir.mkdir(parents=True, exist_ok=True)
    warm_index[["year", "TIO_JJA_std"]].to_csv(
        output_dir / "tio_warm_years.csv", index=False
    )
    pd.DataFrame(
        [{"diagnostic": key, "value": value} for key, value in summary.items()]
    ).to_csv(output_dir / "mechanism_diagnostics.csv", index=False)
    return {
        "fields": fields,
        "p_fields": p_fields,
        "hgt_abs_warm": hgt_abs_warm,
        "profile200_yearly": profile200,
        "profile850_yearly": profile850,
        "profile200_mean": profile200_mean,
        "profile850_mean": profile850_mean,
        "baroclinic_yearly": baroclinic_yearly,
        "summary": summary,
        "sst_clim": sst_clim,
        "olr_stack": olr_stack,
        "sst_stack": sst_stack,
        "hgt_stack": hgt_stack,
        "chi_stack": chi_stack,
        "psi_stack": psi_stack,
        "div_stack": div_stack,
    }


def map_axes(
    fig,
    position: tuple[float, float, float, float],
    extent,
    xticks,
    yticks,
    title: str,
):
    ax = fig.add_axes(position, projection=PROJECTION)
    setup_map(ax, extent, xticks, yticks, title)
    return ax


def add_main_colorbar(fig, mappable, position, label, ticks, ticklabels=None):
    cax = fig.add_axes(position)
    cb = fig.colorbar(mappable, cax=cax, orientation="horizontal", extend="both")
    cb.set_label(label, fontsize=6.2, labelpad=1.6)
    cb.set_ticks(ticks)
    if ticklabels is not None:
        cb.set_ticklabels(ticklabels)
    cb.ax.tick_params(labelsize=5.6, length=2.1, width=0.45, pad=1.4)
    cb.outline.set_linewidth(0.45)
    return cb


def export_figure(
    fig,
    output_dir: Path,
    stem: str,
    panel_axes,
    panel_ids,
    row_groups,
    column_groups,
    formats=("png", "pdf", "svg"),
) -> list[Path]:
    output_dir.mkdir(parents=True, exist_ok=True)
    base = output_dir / stem
    for ax, panel_id in zip(panel_axes, panel_ids):
        # Keep clipped scientific geometry rasterized while labels stay editable.
        for artist in (*ax.collections, *ax.lines, *ax.patches):
            if artist is not ax.patch:
                artist.set_rasterized(True)
        for title_obj in (
            ax.title,
            getattr(ax, "_left_title", None),
            getattr(ax, "_right_title", None),
        ):
            if title_obj is not None:
                title_obj.set_text(
                    re.sub(r"^\([a-z]\)\s*", "", title_obj.get_text())
                )
        label_offset = ScaledTranslation(-10.0 / 72.0, 3.5 / 72.0, fig.dpi_scale_trans)
        ax.text(
            0.0,
            1.0,
            panel_id,
            transform=ax.transAxes + label_offset,
            fontsize=8.0,
            fontweight="bold",
            ha="left",
            va="bottom",
            clip_on=False,
        )
    fig.canvas.draw()
    for ax in panel_axes:
        gridliner = getattr(ax, "_tio_gridliner", None)
        if gridliner is not None:
            grid_artists = (
                *getattr(gridliner, "xline_artists", ()),
                *getattr(gridliner, "yline_artists", ()),
            )
            for artist in grid_artists:
                artist.set_rasterized(True)
    fig.canvas.draw()
    require_matplotlib_panel_alignment(
        fig,
        axes=panel_axes,
        panel_ids=panel_ids,
        row_groups=row_groups,
        column_groups=column_groups,
        json_out=str(base) + ".alignment.json",
        overlay_svg=str(base) + ".alignment.svg",
        tolerance_pt=1.5,
        gutter_tolerance_pt=1.5,
        require_panel_labels=True,
        strict=True,
    )
    saved = []
    if "png" in formats:
        path = base.with_suffix(".png")
        fig.savefig(path, format="png", dpi=FIG_DPI, facecolor="white", transparent=False)
        with Image.open(path) as image:
            rgb = image.convert("RGB")
            temporary = path.with_name(path.stem + ".rgb.tmp.png")
            rgb.save(temporary, dpi=(FIG_DPI, FIG_DPI))
        temporary.replace(path)
        saved.append(path)
    if "pdf" in formats:
        path = base.with_suffix(".pdf")
        fig.savefig(path, format="pdf", facecolor="white", transparent=False)
        saved.append(path)
    if "svg" in formats:
        path = base.with_suffix(".svg")
        fig.savefig(path, format="svg", facecolor="white", transparent=False)
        saved.append(path)
    if "tif" in formats:
        path = base.with_suffix(".tif")
        fig.savefig(
            path,
            format="tif",
            dpi=FIG_DPI,
            facecolor="white",
            transparent=False,
            pil_kwargs={"compression": "tiff_lzw"},
        )
        with Image.open(path) as image:
            rgb = image.convert("RGB")
            temporary = path.with_name(path.stem + ".rgb.tmp.tif")
            rgb.save(temporary, dpi=(FIG_DPI, FIG_DPI), compression="tiff_lzw")
        temporary.replace(path)
        saved.append(path)
    plt.close(fig)
    return saved


