def quiver_on_map(
    ax,
    u: xr.DataArray,
    v: xr.DataArray,
    extent,
    *,
    stride_lat: int = 5,
    stride_lon: int = 8,
    scale: float = 2.8,
    width: float = 0.0014,
    headwidth: float = 3.3,
    headlength: float = 4.0,
    headaxislength: float = 3.6,
    alpha: float = 0.75,
):
    """Draw a sampled vector field with controllable density and prominence."""
    us = subset_region(u, extent).isel(
        lat=slice(None, None, stride_lat), lon=slice(None, None, stride_lon)
    )
    vs = subset_region(v, extent).isel(
        lat=slice(None, None, stride_lat), lon=slice(None, None, stride_lon)
    )
    return ax.quiver(
        us.lon.values,
        us.lat.values,
        us.values,
        vs.values,
        transform=PROJECTION,
        color="#202020",
        alpha=alpha,
        scale_units="inches",
        scale=scale,
        width=width,
        headwidth=headwidth,
        headlength=headlength,
        headaxislength=headaxislength,
        pivot="mid",
        zorder=6,
    )


