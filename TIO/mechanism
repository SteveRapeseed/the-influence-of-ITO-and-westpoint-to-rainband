        f"Area-weighted TIO SST anomaly: {stats['tio_sst_warm_composite_c']:+.2f} °C; "
        f"TIO OLR: {stats['olr_tio_warm_composite_w_m2']:+.2f} W m⁻²; "
        f"WNPAC-box OLR: {stats['olr_wnpac_warm_composite_w_m2']:+.2f} W m⁻².\n"
        "OLR is a convection proxy, not a direct atmospheric-heating measurement.",
        ha="left",
        fontsize=5.8,
    )
    export_figure(
        fig,
        output_dir,
        "step1_tio_heating_diagnosis",
        [ax_sst, ax_olr],
        ["a", "b"],
        [["a", "b"]],
        None,
        formats=formats,
    )


def six_panel_figure(products, output_dir: Path, warm_years: list[int], formats) -> None:
    fields = products["fields"]
    p = products["p_fields"]
    hgt_abs = products["hgt_abs_warm"]
    extent = (60, 180, -20, 40)
    extent_sst = (40, 120, -20, 20)
    extent_hgt = (100, 180, 10, 50)
    fig = plt.figure(figsize=(180 / MM_PER_INCH, 220 / MM_PER_INCH), facecolor="white")
    w, h = 0.39, 0.16
    positions = {
        "a": (0.08, 0.74, w, h),
        "b": (0.53, 0.74, w, h),
        "c": (0.08, 0.46, w, h),
        "d": (0.53, 0.46, w, h),
        "e": (0.08, 0.18, w, h),
        "f": (0.53, 0.18, w, h),
    }
    ax_a = map_axes(
        fig,
        positions["a"],
        extent_sst,
        [40, 60, 80, 100, 120],
        [-20, -10, 0, 10, 20],
        "(a) TIO SST anomaly",
    )
    ax_b = map_axes(
        fig,
        positions["b"],
        extent,
        [60, 90, 120, 150, 180],
        [-20, -10, 0, 10, 20, 30, 40],
        "(b) χ₂₀₀ and divergent wind",
    )
    ax_c = fig.add_axes(positions["c"])
    ax_c.set_box_aspect(0.5)
    ax_c.set_title("(c) Equatorial u anomaly", loc="left", fontsize=7.2, fontweight="bold", pad=3.5)
    ax_d = map_axes(
        fig,
        positions["d"],
        extent,
        [60, 90, 120, 150, 180],
        [-20, -10, 0, 10, 20, 30, 40],
        "(d) ψ₈₅₀ and rotational wind",
    )
    ax_e = map_axes(
        fig,
        positions["e"],
        extent,
        [60, 90, 120, 150, 180],
        [-20, -10, 0, 10, 20, 30, 40],
        "(e) 850-hPa divergence and wind",
    )
    ax_f = map_axes(
        fig,
        positions["f"],
        extent_hgt,
        [100, 120, 140, 160, 180],
        [10, 20, 30, 40, 50],
        "(f) 500-hPa height and 5880-gpm contours",
    )

    im_a = ax_a.contourf(
        fields["sst"].lon,
        fields["sst"].lat,
        fields["sst"],
        levels=np.linspace(-1.2, 1.2, 13),
        cmap="RdBu_r",
        extend="both",
        transform=PROJECTION,
        zorder=1,
    )
    add_significance_dots(ax_a, p["sst"], extent_sst)

    levels = np.linspace(-1.2e7, 1.2e7, 13)
    im_b = ax_b.contourf(
        fields["chi"].lon,
        fields["chi"].lat,
        fields["chi"],
        levels=levels,
        cmap="RdBu_r",
        extend="both",
        transform=PROJECTION,
        zorder=1,
    )
    q_b = quiver_on_map(
        ax_b, fields["divergent_u200"], fields["divergent_v200"], extent
    )
    add_quiver_key(ax_b, q_b, x=0.09, y=0.17)
    add_significance_dots(ax_b, p["chi"], extent)
    draw_region_box(ax_b, (65.0, 108.0, -15.0, 15.0), "#168143", linewidth=0.9)
    draw_region_box(ax_b, WNPAC_REGION, "#a32f33", linestyle="--", linewidth=0.8)

    p200 = products["profile200_yearly"]
    p850 = products["profile850_yearly"]
    m200, lo200, hi200 = confidence_interval(p200.values)
    m850, lo850, hi850 = confidence_interval(p850.values)
    profile_low = min(float(np.nanmin(lo200)), float(np.nanmin(lo850)))
    profile_high = max(float(np.nanmax(hi200)), float(np.nanmax(hi850)))
    profile_ylim = (
        min(-2.5, float(np.floor((profile_low - 0.25) * 2) / 2)),
        max(3.5, float(np.ceil((profile_high + 0.25) * 2) / 2)),
    )
    lon = p200.lon.values
    ax_c.axvspan(120, 160, color="#f0c94b", alpha=0.11, zorder=0)
    ax_c.fill_between(lon, lo200, hi200, color="#c8423e", alpha=0.16, linewidth=0)
    ax_c.fill_between(lon, lo850, hi850, color="#1c5a91", alpha=0.14, linewidth=0)
    ax_c.fill_between(lon, m200, m850, where=m200 > m850, color="#c8423e", alpha=0.12)
    ax_c.plot(lon, m200, color="#bd3936", lw=1.0, label="200 hPa")
    ax_c.plot(lon, m850, color="#205a91", lw=1.0, label="850 hPa")
    ax_c.axhline(0, color="#555555", lw=0.5, ls="--")
    ax_c.set_xlim(60, 180)
    ax_c.set_ylim(*profile_ylim)
    ax_c.set_xticks([60, 90, 120, 150, 180])
    ax_c.yaxis.set_major_locator(MaxNLocator(5))
    ax_c.set_xlabel("Longitude (°E)", fontsize=5.8, labelpad=1)
    ax_c.set_ylabel("u (m s⁻¹)", fontsize=5.8, labelpad=1)
    ax_c.tick_params(labelsize=5.2, pad=1)
    ax_c.legend(
        loc="upper left",
        ncol=2,
        fontsize=5.2,
        frameon=False,
        handlelength=1.3,
        borderaxespad=0.7,
    )

    im_d = ax_d.contourf(
        fields["psi"].lon,
        fields["psi"].lat,
        fields["psi"],
        levels=levels,
        cmap="RdBu_r",
        extend="both",
        transform=PROJECTION,
        zorder=1,
    )
    q_d = quiver_on_map(
        ax_d,
        fields["rotational_u850"],
        fields["rotational_v850"],
        extent,
        stride_lat=3,
        stride_lon=4,
        scale=3.0,
        width=0.0016,
        headwidth=3.4,
        headlength=4.1,
        headaxislength=3.7,
        alpha=0.88,
    )
    add_quiver_key(ax_d, q_d, x=0.09, y=0.17)
    add_significance_dots(ax_d, p["psi"], extent)
    draw_region_box(ax_d, WNPAC_REGION, "#a32f33", linestyle="--", linewidth=0.9)

    div_levels = np.linspace(-8e-6, 8e-6, 13)
    im_e = ax_e.contourf(
        fields["div850"].lon,
        fields["div850"].lat,
        fields["div850"],
        levels=div_levels,
        cmap="BrBG",
        extend="both",
        transform=PROJECTION,
        zorder=1,
    )
    q_e = quiver_on_map(
        ax_e,
        fields["u850"],
        fields["v850"],
        extent,
        stride_lat=3,
        stride_lon=4,
        scale=3.6,
        width=0.0015,
        headwidth=3.2,
        headlength=3.8,
        headaxislength=3.4,
        alpha=0.88,
    )
    add_quiver_key(ax_e, q_e, x=0.09, y=0.17)
    add_significance_dots(ax_e, p["div850"], extent)
    olr_region = subset_region(fields["olr"], extent)
    ax_e.contour(
        olr_region.lon,
        olr_region.lat,
        olr_region,
        levels=[4.0],
        colors=["#8b2d31"],
        linewidths=0.75,
        linestyles="--",
        transform=PROJECTION,
        zorder=7,
    )
    draw_region_box(ax_e, WNPAC_REGION, "#a32f33", linestyle="--", linewidth=0.8)

    im_f = ax_f.contourf(
        fields["hgt"].lon,
        fields["hgt"].lat,
        fields["hgt"],
        levels=np.arange(-80, 81, 10),
        cmap="RdBu_r",
        extend="both",
        transform=PROJECTION,
        zorder=1,
    )
    add_significance_dots(ax_f, p["hgt"], extent_hgt)
    clim = subset_region(fields["hgt_clim"], extent_hgt)
    warm_abs = subset_region(hgt_abs, extent_hgt)
    ax_f.contour(
        clim.lon,
        clim.lat,
        clim,
        levels=[5880.0],
        colors=["#1b5f96"],
        linewidths=0.85,
        linestyles="--",
        transform=PROJECTION,
        zorder=6,
    )
    ax_f.contour(
        warm_abs.lon,
        warm_abs.lat,
        warm_abs,
        levels=[5880.0],
        colors=["#b93432"],
        linewidths=0.85,
        transform=PROJECTION,
        zorder=6,
    )

    add_main_colorbar(fig, im_a, (0.105, 0.69, 0.34, 0.014), "SST (°C)", [-1.2, -0.6, 0, 0.6, 1.2])
    add_main_colorbar(
        fig,
        im_b,
        (0.565, 0.69, 0.32, 0.014),
        "χ₂₀₀ (10⁶ m² s⁻¹)",
        np.linspace(-1.2e7, 1.2e7, 5),
        ["−12", "−6", "0", "6", "12"],
    )
    add_main_colorbar(
        fig,
        im_d,
        (0.565, 0.41, 0.32, 0.014),
        "ψ₈₅₀ (10⁶ m² s⁻¹)",
        np.linspace(-1.2e7, 1.2e7, 5),
        ["−12", "−6", "0", "6", "12"],
    )
    add_main_colorbar(
        fig,
        im_e,
        (0.105, 0.13, 0.34, 0.014),
        "850-hPa divergence (10⁻⁶ s⁻¹)",
        np.linspace(-8e-6, 8e-6, 5),
        ["−8", "−4", "0", "4", "8"],
    )
    add_main_colorbar(
        fig,
        im_f,
        (0.565, 0.13, 0.32, 0.014),
        "500-hPa height anomaly (gpm)",
        [-80, -40, 0, 40, 80],
    )
    fig.text(
        0.5,
        0.96,
        f"TIO warm-year mechanism diagnosis (1979–2020; n = {len(warm_years)})",
        ha="center",
        fontsize=8,
        fontweight="bold",
    )
    fig.text(
        0.08,
        0.045,
        "Contours in (e): OLR anomaly = +4 W m⁻². Dots: nominal p < 0.05; no serial-dependence or field-significance correction.\n"
        "Positive χ indicates convergence; 5880-gpm displacement is geometric.",
        fontsize=5.3,
        color="#333333",
    )
    axes = [ax_a, ax_b, ax_c, ax_d, ax_e, ax_f]
    export_figure(
        fig,
        output_dir,
        "complete_mechanism_diagnosis_6panel",
        axes,
        ["a", "b", "c", "d", "e", "f"],
        [["a", "b"], ["c", "d"], ["e", "f"]],
        [["a", "c", "e"], ["b", "d", "f"]],
        formats=formats,
    )


def write_caption(output_dir: Path, warm_years: list[int], summary: dict) -> None:
    caption = (
        "Figure. TIO warm-year atmospheric response during JJA. (a) 200-hPa velocity "
        "potential χ and divergent wind. (b) 850-hPa streamfunction ψ and rotational "
        "wind. (c) Equatorial zonal-wind anomalies averaged over 5°S–5°N; lines show "
        "warm-year means and bands show 95% t confidence intervals across years. "
        "(d) 500-hPa geopotential-height anomaly, with the 5880-gpm climatological "
        "(blue dashed) and warm-composite (red solid) contours. Warm years are defined "
        "as standardized TIO_JJA > 0.75σ during 1979–2020 (n="
        f"{len(warm_years)}: {', '.join(str(y) for y in warm_years)}); anomalies use "
        "the 1981–2010 JJA climatology. Stippling denotes nominal two-sided one-sample "
        "t-test p<0.05 and is not adjusted for serial dependence or field significance. "
        "The 5880-gpm line measures geometric contour displacement and does not alone "
        "establish dynamical WPSH intensification. The WNP-equatorial baroclinic wind "
        "index (u200-u850, 120–160°E) is "
        f"{summary['u200_minus_u850_west_pacific_m_s']:.2f} m s⁻¹ "
        f"(p={summary['u200_minus_u850_one_sample_p']:.3f}); the warm-composite "
        "5880-gpm west-edge shift relative to climatology is "
        f"{summary['hgt500_5880_geometric_shift_deg_e']:.2f}° longitude. "
        "Framework adapted from Xie et al. (2009)."
    )
    (output_dir / "Figure_Mechanism_Diagnosis_caption.txt").write_text(
        caption + "\n", encoding="utf-8"
    )


def main() -> int:
    args = parse_args()
    if args.dependency_dir:
        sys.path.insert(0, str(args.dependency_dir.resolve()))
    data_dir = args.data_dir.resolve()
    output_dir = args.output_dir.resolve()
    required_files = (
        "HadISST_sst.nc",
        "ncep.uwnd.mon.mean.nc",
        "ncep.vwnd.mon.mean.nc",
        "ncep.hgt.mon.mean.nc",
        "noaa.olr.mon.mean.nc",
        "TIO_JJA.csv",
    )
    missing = [name for name in required_files if not (data_dir / name).is_file()]
    if missing:
        raise FileNotFoundError(
            f"Missing required input files in {data_dir}: {', '.join(missing)}"
        )
    warm_years, warm_index = warm_years_from_index(
        data_dir,
        args.year_start,
        args.year_end,
        args.warm_threshold,
    )
    print(f"Warm years (n={len(warm_years)}): {warm_years}")
    print("Loading 200/850-hPa wind anomalies and computing spherical diagnostics...")
    data = run_vector_diagnostics(
        data_dir,
        warm_years,
        args.year_start,
        args.year_end,
        args.clim_start,
        args.clim_end,
    )
    print("Loading SST, OLR and 500-hPa height composites...")
    products = make_products(
        data_dir,
        output_dir,
        warm_years,
        warm_index,
        data,
        (args.year_start, args.year_end),
        (args.clim_start, args.clim_end),
    )
    formats = ("png", "pdf", "svg", "tif")
    print("Rendering four-panel publication figure...")
    main_figure(products, output_dir, warm_years, formats)
    print("Rendering velocity-potential/streamfunction and Step 1 figures...")
    chi_psi_figure(products, output_dir, warm_years, ("png", "pdf", "svg"))
    step1_figure(products, output_dir, warm_years, ("png", "pdf", "svg"))
    print("Rendering complete six-panel evidence figure...")
    six_panel_figure(products, output_dir, warm_years, ("png", "pdf", "svg"))
    write_caption(output_dir, warm_years, products["summary"])
    print(f"Outputs written to {output_dir}")
    print("Summary:")
    for key, value in products["summary"].items():
        print(f"  {key}: {value}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
