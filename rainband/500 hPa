plt.rcParams["ytick.major.width"] = 0.7
plt.rcParams["xtick.major.size"] = 3
plt.rcParams["ytick.major.size"] = 3
plt.rcParams["pdf.fonttype"] = 42
plt.rcParams["ps.fonttype"] = 42


# 柔和红蓝配色，比默认 RdBu 更适合正文图
nature_cmap = LinearSegmentedColormap.from_list(
    "nature_RdBu_soft",
    [
        "#2166AC",
        "#4393C3",
        "#92C5DE",
        "#D1E5F0",
        "#F7F7F7",
        "#FDDBC7",
        "#F4A582",
        "#D6604D",
        "#B2182B",
    ],
    N=256
)


# ============================================================
# 4. 工具函数
# ============================================================

def smooth_field(field, sigma=1.0):
    out = np.asarray(field, dtype=float).copy()
    valid = np.isfinite(out)

    if valid.sum() == 0:
        return out

    fill_value = np.nanmean(out)
    tmp = np.where(valid, out, fill_value)
    sm = gaussian_filter(tmp, sigma=sigma)
    sm[~valid] = np.nan

    return sm


def add_china_boundary(ax):
    if os.path.exists(CHINA_SHP_PATH):
        reader = shapereader.Reader(CHINA_SHP_PATH)
        geoms = list(reader.geometries())
        ax.add_geometries(
            geoms,
            crs=proj,
            facecolor="none",
            edgecolor="0.15",
            linewidth=0.45,
            zorder=8
        )


def add_region_boxes(ax, add_label=True):
    if not DRAW_REGION_BOXES:
        return

    for name, box in REGION_BOXES_TO_DRAW.items():
        lon_min, lon_max, lat_min, lat_max = box

        rect = Rectangle(
            (lon_min, lat_min),
            lon_max - lon_min,
            lat_max - lat_min,
            linewidth=0.65,
            edgecolor="0.25",
            facecolor="none",
            linestyle="--",
            alpha=0.75,
            transform=proj,
            zorder=9
        )

        ax.add_patch(rect)

        if add_label:
            ax.text(
                lon_min + 0.5,
                lat_max - 1.25,
                name,
                fontsize=6.8,
                fontweight="bold",
                color="0.15",
                alpha=0.9,
                transform=proj,
                zorder=10
            )


def setup_map(ax, add_label=True):
    ax.set_extent(MAP_EXTENT, crs=proj)

    add_china_boundary(ax)
    add_region_boxes(ax, add_label=add_label)

    ax.set_xticks(np.arange(90, 161, 10), crs=proj)
    ax.set_yticks(np.arange(10, 56, 5), crs=proj)

    ax.xaxis.set_major_formatter(LongitudeFormatter())
    ax.yaxis.set_major_formatter(LatitudeFormatter())

    ax.tick_params(labelsize=8, pad=2)

    ax.spines["geo"].set_linewidth(0.65)
    ax.spines["geo"].set_edgecolor("0.15")


# ============================================================
# 5. 读取回归结果
# ============================================================

if not os.path.exists(reg_nc):
    raise FileNotFoundError(
        f"没有找到回归结果文件：\n{reg_nc}\n"
        f"请先运行上一版完整回归代码。"
    )

ds = xr.open_dataset(reg_nc)

print(ds)
print("变量：", list(ds.data_vars))

lats_hgt = ds["lat_hgt"].values
lons_hgt = ds["lon_hgt"].values

lats_wind = ds["lat_wind"].values
lons_wind = ds["lon_wind"].values

lats_pre = ds["lat_pre"].values
lons_pre = ds["lon_pre"].values

lon2d_hgt, lat2d_hgt = np.meshgrid(lons_hgt, lats_hgt)
lon2d_wind, lat2d_wind = np.meshgrid(lons_wind, lats_wind)


# ============================================================
# 6. 色标范围
# ============================================================

colorbar_mask = (
    (lon2d_hgt >= COLORBAR_STAT_EXTENT[0]) & (lon2d_hgt <= COLORBAR_STAT_EXTENT[1]) &
    (lat2d_hgt >= COLORBAR_STAT_EXTENT[2]) & (lat2d_hgt <= COLORBAR_STAT_EXTENT[3])
)

all_abs = []

for group_name in PENTAD_GROUPS.keys():

    hgt_beta = ds[f"{group_name}_hgt500_beta"].values

    if SMOOTH_HGT:
        hgt_plot = smooth_field(hgt_beta, sigma=SMOOTH_SIGMA)
    else:
        hgt_plot = hgt_beta

    vals = hgt_plot[colorbar_mask]
    vals = vals[np.isfinite(vals)]

    if len(vals) > 0:
        all_abs.append(np.nanpercentile(np.abs(vals), 98))

if len(all_abs) == 0:
    vmax_abs = 10.0
else:
    vmax_abs = np.nanmax(all_abs)

# Nature 风格：不要让色标过宽，强制取整到 5 的倍数
cstep = 5
vmax_abs = np.ceil(vmax_abs / cstep) * cstep
vmax_abs = max(vmax_abs, 10)

vmin_plot = -vmax_abs
vmax_plot = vmax_abs

levels = np.linspace(vmin_plot, vmax_plot, 17)
ticks = np.arange(vmin_plot, vmax_plot + cstep * 0.5, cstep)

print("\nHGT 色标范围：", vmin_plot, vmax_plot)
print("HGT 色标刻度：", ticks)


# ============================================================
# 7. 绘图
# ============================================================

fig, axes = plt.subplots(
    1,
    2,
    figsize=(9.4, 3.35),
    subplot_kw={"projection": proj},
    dpi=450
)

axes = axes.flatten()

panel_labels = ["a", "b"]

cf = None
qv_plot = None

for ax, panel_label, group_name in zip(axes, panel_labels, PENTAD_GROUPS.keys()):

    if panel_label == "a":
        setup_map(ax, add_label=True)
    else:
        setup_map(ax, add_label=False)

    title_name = PENTAD_GROUPS[group_name]

    hgt_beta = ds[f"{group_name}_hgt500_beta"].values
    hgt_clim = ds[f"{group_name}_hgt500_clim"].values

    u500_beta = ds[f"{group_name}_u500_beta"].values
    v500_beta = ds[f"{group_name}_v500_beta"].values

    pre_beta = ds[f"{group_name}_pre_beta"].values

    if SMOOTH_HGT:
        hgt_plot = smooth_field(hgt_beta, sigma=SMOOTH_SIGMA)
    else:
        hgt_plot = hgt_beta

    if SMOOTH_WIND:
        u500_plot = smooth_field(u500_beta, sigma=SMOOTH_SIGMA)
        v500_plot = smooth_field(v500_beta, sigma=SMOOTH_SIGMA)
    else:
        u500_plot = u500_beta
        v500_plot = v500_beta

    wind_mag_plot = np.sqrt(u500_plot ** 2 + v500_plot ** 2)

    # ------------------------------------------------------------
    # 填色：500 hPa HGT 对 WRI 的回归
    # ------------------------------------------------------------
    cf = ax.contourf(
        lons_hgt,
        lats_hgt,
        hgt_plot,
        levels=levels,
        cmap=nature_cmap,
        extend="both",
        transform=proj,
        zorder=1
    )

    # HGT 回归 0 线
    try:
        ax.contour(
            lons_hgt,
            lats_hgt,
            hgt_plot,
            levels=[0],
            colors="0.20",
            linewidths=0.65,
            transform=proj,
            zorder=4
        )
    except Exception:
        pass

    # 5880 gpm 气候态线
    if DRAW_5880_CONTOUR:
        try:
            cs5880 = ax.contour(
                lons_hgt,
                lats_hgt,
                hgt_clim,
                levels=[HGT_CLIM_CONTOUR],
                colors="0.05",
                linewidths=1.15,
                linestyles="solid",
                transform=proj,
                zorder=6
            )

            ax.clabel(
                cs5880,
                fmt={HGT_CLIM_CONTOUR: "5880"},
                fontsize=6.5,
                inline=True,
                inline_spacing=2
            )
        except Exception:
            pass

    # 降水正回归核心区，弱化为灰色虚线
    if DRAW_PRECIP_CONTOUR:
        try:
            ax.contour(
                lons_pre,
                lats_pre,
                pre_beta,
                levels=[PRECIP_CONTOUR_LEVEL],
                colors="0.45",
                linewidths=0.85,
                linestyles="--",
                transform=proj,
                zorder=6
            )
        except Exception:
            pass

    # ------------------------------------------------------------
    # 500 hPa 风场回归箭头
    # ------------------------------------------------------------
    map_mask_wind = (
        (lon2d_wind >= MAP_EXTENT[0]) & (lon2d_wind <= MAP_EXTENT[1]) &
        (lat2d_wind >= MAP_EXTENT[2]) & (lat2d_wind <= MAP_EXTENT[3])
    )

    mag_vals = wind_mag_plot[map_mask_wind]
    mag_vals = mag_vals[np.isfinite(mag_vals)]

    if len(mag_vals) > 0:
        wind_threshold = np.nanpercentile(mag_vals, WIND_VECTOR_PERCENTILE)
    else:
        wind_threshold = 0.0

    arrow_mask = (
        map_mask_wind &
        np.isfinite(u500_plot) &
        np.isfinite(v500_plot) &
        (wind_mag_plot >= wind_threshold)
    )

    u_plot = np.where(arrow_mask, u500_plot, np.nan)
    v_plot = np.where(arrow_mask, v500_plot, np.nan)

    skip = QUIVER_SKIP

    qv_plot = ax.quiver(
        lon2d_wind[::skip, ::skip],
        lat2d_wind[::skip, ::skip],
        u_plot[::skip, ::skip],
        v_plot[::skip, ::skip],
        transform=proj,
        scale=QUIVER_SCALE,
        width=QUIVER_WIDTH,
        headwidth=3.4,
        headlength=4.0,
        headaxislength=3.6,
        color="0.05",
        alpha=0.88,
        zorder=7
    )

    ax.set_title(
        f"({panel_label}) {title_name}",
        loc="left",
        fontsize=9.5,
        fontweight="bold",
        pad=4
    )


