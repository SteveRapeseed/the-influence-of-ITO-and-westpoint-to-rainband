QUIVER_SKIP = 3
QUIVER_SCALE = 28
QUIVER_WIDTH = 0.00115
QUIVER_KEY_VALUE = 2.0
WIND_VECTOR_PERCENTILE = 25

proj = ccrs.PlateCarree()


