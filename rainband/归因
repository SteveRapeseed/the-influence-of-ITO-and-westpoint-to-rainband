print("v:", v.shape)
print("q:", q.shape)


# ============================================================
# 7. 气候态与异常
# ============================================================

u_clim = u.mean(dim=year_name)
v_clim = v.mean(dim=year_name)
q_clim = q.mean(dim=year_name)

u_ano = u - u_clim
v_ano = v - v_clim
q_ano = q - q_clim


# ============================================================
# 8. 水汽通量辐合分解
# ============================================================

print("\nCalculating dynamic contribution...")
fu_dyn = vertical_integrate(q_clim * u_ano, level_name)
fv_dyn = vertical_integrate(q_clim * v_ano, level_name)
mfc_dyn = spherical_divergence(fu_dyn, fv_dyn, lat_name, lon_name)

print("Calculating thermodynamic contribution...")
fu_therm = vertical_integrate(q_ano * u_clim, level_name)
fv_therm = vertical_integrate(q_ano * v_clim, level_name)
mfc_therm = spherical_divergence(fu_therm, fv_therm, lat_name, lon_name)

print("Calculating nonlinear contribution...")
fu_nl = vertical_integrate(q_ano * u_ano, level_name)
fv_nl = vertical_integrate(q_ano * v_ano, level_name)
mfc_nl = spherical_divergence(fu_nl, fv_nl, lat_name, lon_name)

print("Calculating total MFC anomaly for closure check...")
fu_total = vertical_integrate(q * u, level_name)
fv_total = vertical_integrate(q * v, level_name)
mfc_total = spherical_divergence(fu_total, fv_total, lat_name, lon_name)

mfc_total_clim = mfc_total.mean(dim=year_name)
mfc_total_ano = mfc_total - mfc_total_clim

closure = mfc_dyn + mfc_therm + mfc_nl - mfc_total_ano
print("Closure check mean:", float(closure.mean(skipna=True).values))
print("Closure check max abs:", float(np.nanmax(np.abs(closure.values))))


# ============================================================
# 9. 区域平均与回归
