def standardize_1d(x):
    x = np.asarray(x, dtype=float)
    return (x - np.nanmean(x)) / np.nanstd(x)


def safe_detrend_1d(x):
    x = np.asarray(x, dtype=float)
    mask = np.isfinite(x)

    if mask.sum() < 5:
        raise ValueError("有效样本太少，无法去趋势。")

    out = x.copy()
    out[mask] = signal.detrend(x[mask], type="linear")
    return out


def read_wri_excel_auto(wri_file, year_start=1961, year_end=2020):
    xls = pd.ExcelFile(wri_file)
    best = None

    print("\nWRI Excel sheets:", xls.sheet_names)

    for sheet in xls.sheet_names:
        raw = pd.read_excel(wri_file, sheet_name=sheet, header=None)
        nrow, ncol = raw.shape

        for iy_col in range(ncol):
            year_num = pd.to_numeric(raw.iloc[:, iy_col], errors="coerce")

            year_like = (
                year_num.notna()
                & (year_num >= year_start)
                & (year_num <= year_end)
                & (np.abs(year_num - np.round(year_num)) < 1e-6)
            )

            if year_like.sum() < 20:
                continue

            for iw_col in range(ncol):
                if iw_col == iy_col:
                    continue

                wri_num = pd.to_numeric(raw.iloc[:, iw_col], errors="coerce")
                valid = year_like & wri_num.notna()

                if valid.sum() < 20:
                    continue

                tmp = pd.DataFrame({
                    "year": year_num[valid].astype(int).values,
                    "WRI": wri_num[valid].astype(float).values,
                })

                tmp = tmp.drop_duplicates(subset=["year"], keep="first")
                tmp = tmp.sort_values("year").reset_index(drop=True)

                overlap_years = sorted(
                    list(
                        set(tmp["year"].values)
                        .intersection(set(np.arange(year_start, year_end + 1)))
                    )
                )

                score = len(overlap_years)

                first_valid_row = np.where(valid.values)[0][0]
                header_start = max(0, first_valid_row - 8)
                header_end = first_valid_row

                try:
                    header_cells = raw.iloc[header_start:header_end, iw_col].astype(str).values
                    header_text = " ".join(header_cells)
                except Exception:
                    header_text = ""

                header_lower = header_text.lower()

                if "wri_std" in header_lower:
                    score += 300
                elif "wri" in header_lower:
                    score += 200
                elif "index" in header_lower:
                    score += 50

                if ("lon" in header_lower) or ("longitude" in header_lower) or ("经度" in header_lower):
                    score -= 100

                candidate = {
                    "score": score,
                    "sheet": sheet,
                    "year_col": iy_col,
                    "wri_col": iw_col,
                    "data": tmp,
                    "header_text": header_text,
                }

                if best is None or candidate["score"] > best["score"]:
                    best = candidate

    if best is None:
        raise ValueError("没有在 WRI Excel 中找到可用的年份列和 WRI 数值列。")

    wri_df = best["data"].copy()

    print("\n========== WRI detected ==========")
    print("sheet:", best["sheet"])
    print("year_col:", best["year_col"])
    print("wri_col:", best["wri_col"])
    print("header:", best["header_text"])
    print(wri_df.head())
    print(wri_df.tail())

    return wri_df


def guess_coord_names(ds):
    names = list(ds.coords) + list(ds.dims)

    def find_one(candidates):
        for c in candidates:
            for n in names:
                if n.lower() == c.lower():
                    return n
        return None

    year_name = find_one(["year", "yr", "time_year"])
    pentad_name = find_one(["pentad", "pentads", "p"])
    level_name = find_one(["level", "lev", "plev", "pressure", "isobaric"])
    lat_name = find_one(["lat", "latitude"])
    lon_name = find_one(["lon", "longitude"])

    return year_name, pentad_name, level_name, lat_name, lon_name


def guess_var(ds, candidates):
    for c in candidates:
        if c in ds.data_vars:
            return c

    for v in ds.data_vars:
        vl = v.lower()
        for c in candidates:
            if vl == c.lower():
                return v

    for v in ds.data_vars:
        vl = v.lower()
        for c in candidates:
            if c.lower() in vl:
                return v

    return None


def sort_latlon(da, lat_name, lon_name):
    if da[lat_name].values[0] > da[lat_name].values[-1]:
        da = da.sortby(lat_name)

    if da[lon_name].values[0] > da[lon_name].values[-1]:
        da = da.sortby(lon_name)

    return da


def select_pressure_levels(ds, level_name, target_levels_hpa):
    lev_vals = ds[level_name].values.astype(float)

    if np.nanmax(lev_vals) > 2000:
        target_vals = np.array(target_levels_hpa, dtype=float) * 100.0
    else:
        target_vals = np.array(target_levels_hpa, dtype=float)

    available = ds[level_name].values.astype(float)

    selected = []
    for tv in target_vals:
        idx = np.argmin(np.abs(available - tv))
        selected.append(ds[level_name].values[idx])

    selected = np.unique(selected)

    print("\nTarget levels hPa:", target_levels_hpa)
    print("Selected levels in file:", selected)

    return ds.sel({level_name: selected})


def get_lat_slice(coord, lat1, lat2):
    vals = coord.values
    if vals[0] < vals[-1]:
        return slice(lat1, lat2)
    else:
        return slice(lat2, lat1)


def get_lon_slice(coord, lon1, lon2):
    vals = coord.values
    if vals[0] < vals[-1]:
        return slice(lon1, lon2)
    else:
        return slice(lon2, lon1)


def area_weighted_mean(da, lat_name, lon_name, region):
    lon1, lon2, lat1, lat2 = region

    sub = da.sel({
        lon_name: get_lon_slice(da[lon_name], lon1, lon2),
        lat_name: get_lat_slice(da[lat_name], lat1, lat2),
    })

    weights = np.cos(np.deg2rad(sub[lat_name]))

    return sub.weighted(weights).mean(dim=[lat_name, lon_name])


def vertical_integrate(da, level_name):
    """
    对气压层做垂直积分：∫ X dp / g

    说明：
    1. 会自动按气压层升序排序。
    2. 如果层次单位是 hPa，则转为 Pa。
    3. 输出保留原有其他维度顺序。
    """

    da = da.sortby(level_name)

    p = da[level_name].values.astype(float)

    if np.nanmax(p) < 2000:
        p = p * 100.0

    axis = da.get_axis_num(level_name)

    arr = np.trapz(da.values, x=p, axis=axis) / GRAV

    out_dims = [d for d in da.dims if d != level_name]
    out_coords = {d: da.coords[d] for d in out_dims}

    return xr.DataArray(
        arr,
        coords=out_coords,
        dims=out_dims,
    )


def spherical_divergence(fu, fv, lat_name, lon_name):
    """
    球面散度：
    div(F) = 1/(a cosφ) * dFu/dλ + 1/(a cosφ) * d(Fv cosφ)/dφ
    MFC = -div(F)

    这个版本会强制把维度顺序整理为：
    [..., lat, lon]
    避免 np.gradient 维度不匹配。
    """

    # 先对齐 fu 和 fv
    fu, fv = xr.align(fu, fv, join="inner")

    # 保证纬度、经度升序
    if fu[lat_name].values[0] > fu[lat_name].values[-1]:
        fu = fu.sortby(lat_name)
        fv = fv.sortby(lat_name)

    if fu[lon_name].values[0] > fu[lon_name].values[-1]:
        fu = fu.sortby(lon_name)
        fv = fv.sortby(lon_name)

    # 强制 lat/lon 为最后两维
    other_dims = [d for d in fu.dims if d not in [lat_name, lon_name]]
    new_order = other_dims + [lat_name, lon_name]

    fu = fu.transpose(*new_order)
    fv = fv.transpose(*new_order)

    lat = fu[lat_name].values.astype(float)
    lon = fu[lon_name].values.astype(float)

    lat_rad = np.deg2rad(lat)
    lon_rad = np.deg2rad(lon)

    cosphi = np.cos(lat_rad)
    cosphi = np.where(np.abs(cosphi) < 1e-8, np.nan, cosphi)

    fu_arr = fu.values
    fv_arr = fv.values

    # 明确检查，避免隐藏错误
    if fu_arr.shape[-1] != len(lon_rad):
        raise ValueError(
            f"经度维度不匹配：fu 最后一维长度={fu_arr.shape[-1]}, "
            f"lon长度={len(lon_rad)}，fu.dims={fu.dims}"
        )

    if fu_arr.shape[-2] != len(lat_rad):
        raise ValueError(
            f"纬度维度不匹配：fu 倒数第二维长度={fu_arr.shape[-2]}, "
            f"lat长度={len(lat_rad)}，fu.dims={fu.dims}"
        )

    # dFu / dλ
    dFu_dlam = np.gradient(
        fu_arr,
        lon_rad,
        axis=-1,
        edge_order=2
    )

    # d(Fv cosφ) / dφ
    shape = [1] * fv_arr.ndim
    shape[-2] = len(lat)
    shape[-1] = 1

    cosphi_nd = cosphi.reshape(shape)

    fv_cos = fv_arr * cosphi_nd

    dFvcos_dphi = np.gradient(
        fv_cos,
        lat_rad,
        axis=-2,
        edge_order=2
    )

    div = (dFu_dlam + dFvcos_dphi) / (R_EARTH * cosphi_nd)

    mfc = -div

    out = xr.DataArray(
        mfc,
        coords=fu.coords,
        dims=fu.dims,
        name="mfc",
    )

    return out


def regress_beta_p_r(y, x, detrend_y=True):
    y = np.asarray(y, dtype=float)
    x = np.asarray(x, dtype=float)

    mask = np.isfinite(y) & np.isfinite(x)

    y = y[mask]
    x = x[mask]

    if len(y) < 10:
        return np.nan, np.nan, np.nan

    if detrend_y:
        y = safe_detrend_1d(y)

    res = linregress(x, y)

    return res.slope, res.pvalue, res.rvalue


