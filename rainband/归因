            region_series = area_weighted_mean(
                da_p,
                lat_name=lat_name,
                lon_name=lon_name,
                region=region_box,
            )

            beta, pval, rval = regress_beta_p_r(
                y=region_series.values,
                x=wri_used,
                detrend_y=DETREND_SERIES,
            )

            region_values[term_name] = beta

