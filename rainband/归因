need_pentads = sorted(list(set(sum(PENTAD_GROUPS.values(), []))))

ds = ds.sel({year_name: years_target})
ds = ds.sel({pentad_name: need_pentads})
ds = select_pressure_levels(ds, level_name, LEVELS_USED_HPA)

u = ds[u_var]
v = ds[v_var]
q = ds[q_var]

u = sort_latlon(u, lat_name, lon_name)
v = sort_latlon(v, lat_name, lon_name)
q = sort_latlon(q, lat_name, lon_name)

u = u.transpose(year_name, pentad_name, level_name, lat_name, lon_name)
v = v.transpose(year_name, pentad_name, level_name, lat_name, lon_name)
q = q.transpose(year_name, pentad_name, level_name, lat_name, lon_name)

print("\nSelected UVQ shape:")
