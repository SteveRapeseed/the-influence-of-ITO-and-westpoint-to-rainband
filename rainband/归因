term_data = {
    "Dynamic": mfc_dyn,
    "Thermodynamic": mfc_therm,
    "Nonlinear": mfc_nl,
    "Total": mfc_total_ano,
}

rows = []

for period_name, pentads in PENTAD_GROUPS.items():

    print("\nProcessing:", period_name, pentads)

    for region_name, region_box in REGIONS.items():

        region_values = {}

        for term_name, da_term in term_data.items():

