def detrend_3d_by_year(data3d):
    arr = np.asarray(data3d, dtype=float)
    nt, ny, nx = arr.shape

    arr2 = arr.reshape(nt, ny * nx)
    out2 = np.full_like(arr2, np.nan, dtype=float)

    t = np.arange(nt)

    for i in range(ny * nx):
        y = arr2[:, i]
        valid = np.isfinite(y)

        if valid.sum() >= int(nt * 0.8):
            coef = np.polyfit(t[valid], y[valid], 1)
            trend = coef[0] * t + coef[1]
            out2[:, i] = y - trend

    return out2.reshape(nt, ny, nx)


def regress_grid(y3d, x1d):
    y3d = np.asarray(y3d, dtype=float)
    x1d = np.asarray(x1d, dtype=float)

    nt, ny, nx = y3d.shape

    beta = np.full((ny, nx), np.nan)
    rmap = np.full((ny, nx), np.nan)
    pmap = np.full((ny, nx), np.nan)

    for iy in range(ny):
        for ix in range(nx):
            y = y3d[:, iy, ix]
            valid = np.isfinite(y) & np.isfinite(x1d)

            if valid.sum() >= 15:
                res = linregress(x1d[valid], y[valid])
                beta[iy, ix] = res.slope
                rmap[iy, ix] = res.rvalue
                pmap[iy, ix] = res.pvalue

    return beta, rmap, pmap


def vertical_integrated_moisture_flux(u_da, v_da, q_da, levels_use):
    g = 9.80665

    u_sel = u_da.sel(level=levels_use)
    v_sel = v_da.sel(level=levels_use)
    q_sel = q_da.sel(level=levels_use)

    u_sel = u_sel.sortby("level", ascending=False)
    v_sel = v_sel.sortby("level", ascending=False)
    q_sel = q_sel.sortby("level", ascending=False)

    p_pa = u_sel["level"].values.astype(float) * 100.0

    qu = q_sel.values.astype(float) * u_sel.values.astype(float)
    qv = q_sel.values.astype(float) * v_sel.values.astype(float)

    p_inc = p_pa[::-1]
    qu_inc = qu[:, ::-1, :, :]
    qv_inc = qv[:, ::-1, :, :]

    ivtu = np.trapz(qu_inc, p_inc, axis=1) / g
    ivtv = np.trapz(qv_inc, p_inc, axis=1) / g

    return ivtu, ivtv


def calc_divergence_sphere(fx, fy, lats, lons):
    a = 6.371e6

    fx = np.asarray(fx, dtype=float)
    fy = np.asarray(fy, dtype=float)

    lat_rad = np.deg2rad(lats)
    lon_rad = np.deg2rad(lons)

    coslat = np.cos(lat_rad)
    coslat_3d = coslat[None, :, None]

    dfx_dlon = np.gradient(fx, lon_rad, axis=2, edge_order=2)
    dfy_dlat = np.gradient(fy, lat_rad, axis=1, edge_order=2)

    div = dfx_dlon / (a * coslat_3d) + dfy_dlat / a

    return div


def smooth_field(field, sigma=1.0):
    out = field.copy()
    valid = np.isfinite(out)

    if valid.sum() == 0:
        return out

    fill_value = np.nanmean(out)
    tmp = np.where(valid, out, fill_value)
    sm = gaussian_filter(tmp, sigma=sigma)

    sm[~valid] = np.nan

    return sm


def add_china_boundary(ax):
    if os.path.exists(CHINA_SHP_PATH):
        reader = shapereader.Reader(CHINA_SHP_PATH)
        geoms = list(reader.geometries())
        ax.add_geometries(
            geoms,
            crs=proj,
            facecolor="none",
            edgecolor="black",
            linewidth=0.6,
            zorder=8
        )


def add_region_boxes(ax, add_label=True):
    if not DRAW_REGION_BOXES:
        return

    for name, box in REGION_BOXES_TO_DRAW.items():
        lon_min, lon_max, lat_min, lat_max = box

        rect = Rectangle(
            (lon_min, lat_min),
            lon_max - lon_min,
            lat_max - lat_min,
            linewidth=0.85,
            edgecolor="black",
            facecolor="none",
            linestyle="--",
            alpha=0.70,
            transform=proj,
            zorder=9
        )

        ax.add_patch(rect)

        if add_label:
            ax.text(
                lon_min + 0.5,
                lat_max - 1.4,
                name,
                fontsize=7.5,
                fontweight="bold",
                color="black",
                alpha=0.85,
                transform=proj,
                zorder=10
            )


def setup_map(ax, add_label=True):
    ax.set_extent(MAP_EXTENT, crs=proj)

    add_china_boundary(ax)
    add_region_boxes(ax, add_label=add_label)

    ax.set_xticks(np.arange(90, 141, 10), crs=proj)
    ax.set_yticks(np.arange(15, 56, 5), crs=proj)

    ax.xaxis.set_major_formatter(LongitudeFormatter())
    ax.yaxis.set_major_formatter(LatitudeFormatter())

