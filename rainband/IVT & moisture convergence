def read_wri_excel_auto(wri_file, pre_years, year_start=1961, year_end=2020):
    xls = pd.ExcelFile(wri_file)
    best = None

    print("\nWRI Excel 包含的 sheet：", xls.sheet_names)

    for sheet in xls.sheet_names:
        raw = pd.read_excel(wri_file, sheet_name=sheet, header=None)
        nrow, ncol = raw.shape

        for iy_col in range(ncol):

            year_num = pd.to_numeric(raw.iloc[:, iy_col], errors="coerce")

            year_like = (
                year_num.notna() &
                (year_num >= year_start) &
                (year_num <= year_end) &
                (np.abs(year_num - np.round(year_num)) < 1e-6)
            )

            if year_like.sum() < 20:
                continue

            for iw_col in range(ncol):

                if iw_col == iy_col:
                    continue

                wri_num = pd.to_numeric(raw.iloc[:, iw_col], errors="coerce")
                valid = year_like & wri_num.notna()

                if valid.sum() < 20:
                    continue

                tmp = pd.DataFrame({
                    "year": year_num[valid].astype(int).values,
                    "WRI": wri_num[valid].astype(float).values
                })

                tmp = tmp.drop_duplicates(subset=["year"], keep="first")
                tmp = tmp.sort_values("year").reset_index(drop=True)

                overlap_years = sorted(
                    list(
                        set(tmp["year"].values)
                        .intersection(set(pre_years))
                        .intersection(set(np.arange(year_start, year_end + 1)))
                    )
                )

                score = len(overlap_years)

                first_valid_row = np.where(valid.values)[0][0]
                header_start = max(0, first_valid_row - 8)
                header_end = first_valid_row

                try:
                    header_cells = raw.iloc[header_start:header_end, iw_col].astype(str).values
                    header_text = " ".join(header_cells)
                except Exception:
                    header_text = ""

                header_lower = header_text.lower()

                if "wri_std" in header_lower:
                    score += 300
                elif "wri" in header_lower:
                    score += 200
                elif "index" in header_lower:
                    score += 50

                if ("lon" in header_lower) or ("longitude" in header_lower) or ("经度" in header_lower):
                    score -= 100

                candidate = {
                    "score": score,
                    "sheet": sheet,
                    "year_col": iy_col,
                    "wri_col": iw_col,
                    "data": tmp,
                    "overlap_years": overlap_years,
                    "header_text": header_text,
                }

                if best is None or candidate["score"] > best["score"]:
                    best = candidate

    if best is None:
        raise ValueError("没有在 WRI Excel 中找到可用的年份列和 WRI 数值列。")

    wri_df = best["data"].copy()

    print("\n========== WRI 自动识别结果 ==========")
    print("使用 sheet:", best["sheet"])
    print("年份列位置:", best["year_col"])
    print("WRI 列位置:", best["wri_col"])
    print("疑似表头文字:", best["header_text"])
    print("共同年份数量:", len(best["overlap_years"]))
    print(wri_df.head())
    print(wri_df.tail())

    return wri_df


