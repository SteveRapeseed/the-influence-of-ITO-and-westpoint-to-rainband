results = {}

for group_name, pentad_list in PENTAD_GROUPS.items():

    print("\n正在处理：", group_name, pentad_list)

    pentad_list_pre = [p for p in pentad_list if p in pentads_pre]
    pentad_list_uvq = [p for p in pentad_list if p in pentads_uvq]

    if len(pentad_list_pre) == 0:
        raise ValueError(f"降水数据中不存在候段：{pentad_list}")

    if len(pentad_list_uvq) == 0:
        raise ValueError(f"UVQ 数据中不存在候段：{pentad_list}")

    pre_group = pre_common.sel(pentad=pentad_list_pre).sum(dim="pentad")
    pre_values = pre_group.values.astype(float)

    pre_ano = pre_values - np.nanmean(pre_values, axis=0)

    if USE_DETRENDED:
        pre_reg_input = detrend_3d_by_year(pre_ano)
    else:
        pre_reg_input = pre_ano

    pre_beta, pre_r, pre_p = regress_grid(pre_reg_input, wri_for_reg)

    u_group = u_common.sel(pentad=pentad_list_uvq).mean(dim="pentad")
    v_group = v_common.sel(pentad=pentad_list_uvq).mean(dim="pentad")
    q_group = q_common.sel(pentad=pentad_list_uvq).mean(dim="pentad")

    ivtu, ivtv = vertical_integrated_moisture_flux(
        u_da=u_group,
        v_da=v_group,
        q_da=q_group,
        levels_use=FLUX_LEVELS
    )

    ivtu_ano = ivtu - np.nanmean(ivtu, axis=0)
    ivtv_ano = ivtv - np.nanmean(ivtv, axis=0)

    if USE_DETRENDED:
        ivtu_reg_input = detrend_3d_by_year(ivtu_ano)
        ivtv_reg_input = detrend_3d_by_year(ivtv_ano)
    else:
        ivtu_reg_input = ivtu_ano
        ivtv_reg_input = ivtv_ano

    ivtu_beta, ivtu_r, ivtu_p = regress_grid(ivtu_reg_input, wri_for_reg)
    ivtv_beta, ivtv_r, ivtv_p = regress_grid(ivtv_reg_input, wri_for_reg)

    div_ivt = calc_divergence_sphere(
        fx=ivtu,
        fy=ivtv,
        lats=lats_uvq,
        lons=lons_uvq
    )

    conv = -div_ivt * 86400.0

    conv_ano = conv - np.nanmean(conv, axis=0)

    if USE_DETRENDED:
        conv_reg_input = detrend_3d_by_year(conv_ano)
    else:
        conv_reg_input = conv_ano

    conv_beta, conv_r, conv_p = regress_grid(conv_reg_input, wri_for_reg)

    if SMOOTH_FLUX:
        ivtu_plot = smooth_field(ivtu_beta, sigma=SMOOTH_SIGMA)
        ivtv_plot = smooth_field(ivtv_beta, sigma=SMOOTH_SIGMA)
    else:
        ivtu_plot = ivtu_beta
        ivtv_plot = ivtv_beta

    if SMOOTH_CONV:
        conv_plot = smooth_field(conv_beta, sigma=SMOOTH_SIGMA)
    else:
        conv_plot = conv_beta

    flux_mag_plot = np.sqrt(ivtu_plot ** 2 + ivtv_plot ** 2)

    results[group_name] = {
        "pre_beta": pre_beta,
        "pre_r": pre_r,
        "pre_p": pre_p,

        "ivtu_beta": ivtu_beta,
        "ivtv_beta": ivtv_beta,
        "ivtu_plot": ivtu_plot,
        "ivtv_plot": ivtv_plot,
        "flux_mag_plot": flux_mag_plot,

        "conv_beta": conv_beta,
        "conv_r": conv_r,
        "conv_p": conv_p,
        "conv_plot": conv_plot,
    }

    print(group_name, "降水 beta min/max:", np.nanmin(pre_beta), np.nanmax(pre_beta))
    print(group_name, "水汽辐合 beta min/max:", np.nanmin(conv_beta), np.nanmax(conv_beta))
    print(group_name, "IVT magnitude max:", np.nanmax(flux_mag_plot))


