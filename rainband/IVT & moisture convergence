    if DRAW_PRECIP_CONTOUR:
        try:
            ax.contour(
                lons_pre,
                lats_pre,
                pre_beta,
                levels=[PRECIP_CONTOUR_LEVEL],
                colors="black",
                linewidths=1.2,
                linestyles="solid",
                transform=proj,
                zorder=6
            )
        except Exception:
            pass

    map_mask_uvq = (
        (lon2d_uvq >= MAP_EXTENT[0]) & (lon2d_uvq <= MAP_EXTENT[1]) &
        (lat2d_uvq >= MAP_EXTENT[2]) & (lat2d_uvq <= MAP_EXTENT[3])
    )

    mag_vals = flux_mag_plot[map_mask_uvq]
    mag_vals = mag_vals[np.isfinite(mag_vals)]

    if len(mag_vals) > 0:
        flux_threshold = np.nanpercentile(mag_vals, FLUX_VECTOR_PERCENTILE)
    else:
        flux_threshold = 0.0

    arrow_mask = (
        map_mask_uvq &
        np.isfinite(ivtu_plot) &
        np.isfinite(ivtv_plot) &
        (flux_mag_plot >= flux_threshold)
    )

    u_plot = np.where(arrow_mask, ivtu_plot, np.nan)
    v_plot = np.where(arrow_mask, ivtv_plot, np.nan)

    skip = QUIVER_SKIP

    qv_plot = ax.quiver(
        lon2d_uvq[::skip, ::skip],
        lat2d_uvq[::skip, ::skip],
        u_plot[::skip, ::skip],
        v_plot[::skip, ::skip],
        transform=proj,
        scale=QUIVER_SCALE,
        width=QUIVER_WIDTH,
        headwidth=3.5,
        headlength=4.2,
        headaxislength=3.8,
        color="black",
        zorder=7
    )

    ax.set_title(
        f"{panel_label} {title_names[group_name]}",
        loc="left",
        fontsize=14,
        fontweight="bold",
        pad=7
    )

