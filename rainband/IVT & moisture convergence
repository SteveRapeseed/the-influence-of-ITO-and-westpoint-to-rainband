regional_rows = []

for group_name in PENTAD_GROUPS.keys():

    pre_beta = results[group_name]["pre_beta"]
    pre_p = results[group_name]["pre_p"]

    conv_beta = results[group_name]["conv_beta"]
    conv_p = results[group_name]["conv_p"]

    ivtu_beta = results[group_name]["ivtu_beta"]
    ivtv_beta = results[group_name]["ivtv_beta"]
    flux_mag = np.sqrt(ivtu_beta ** 2 + ivtv_beta ** 2)

    for region_name, box in REGIONS.items():

        lon_min, lon_max, lat_min, lat_max = box

        pre_mask = (
            (lon2d_pre >= lon_min) & (lon2d_pre <= lon_max) &
            (lat2d_pre >= lat_min) & (lat2d_pre <= lat_max)
        )

        uvq_mask = (
            (lon2d_uvq >= lon_min) & (lon2d_uvq <= lon_max) &
            (lat2d_uvq >= lat_min) & (lat2d_uvq <= lat_max)
        )

        pre_vals = pre_beta[pre_mask]
        pre_p_vals = pre_p[pre_mask]

        conv_vals = conv_beta[uvq_mask]
        conv_p_vals = conv_p[uvq_mask]

        ivtu_vals = ivtu_beta[uvq_mask]
        ivtv_vals = ivtv_beta[uvq_mask]
        flux_vals = flux_mag[uvq_mask]

        regional_rows.append({
            "group": group_name,
            "region": region_name,

            "precip_beta_mean_mm_per_1std_WRI": np.nanmean(pre_vals),
            "precip_beta_median_mm_per_1std_WRI": np.nanmedian(pre_vals),
            "precip_positive_fraction": np.nanmean(pre_vals > 0),
            "precip_p05_fraction": np.nanmean((pre_p_vals < 0.05) & np.isfinite(pre_p_vals)),
            "precip_p10_fraction": np.nanmean((pre_p_vals < 0.10) & np.isfinite(pre_p_vals)),

            "moisture_convergence_beta_mean_mm_day_per_1std_WRI": np.nanmean(conv_vals),
            "moisture_convergence_beta_median_mm_day_per_1std_WRI": np.nanmedian(conv_vals),
            "moisture_convergence_positive_fraction": np.nanmean(conv_vals > 0),
            "moisture_convergence_p05_fraction": np.nanmean((conv_p_vals < 0.05) & np.isfinite(conv_p_vals)),
            "moisture_convergence_p10_fraction": np.nanmean((conv_p_vals < 0.10) & np.isfinite(conv_p_vals)),

            "IVT_u_beta_mean_kg_m-1_s-1_per_1std_WRI": np.nanmean(ivtu_vals),
            "IVT_v_beta_mean_kg_m-1_s-1_per_1std_WRI": np.nanmean(ivtv_vals),
            "IVT_magnitude_beta_mean_kg_m-1_s-1_per_1std_WRI": np.nanmean(flux_vals),
            "IVT_magnitude_beta_median_kg_m-1_s-1_per_1std_WRI": np.nanmedian(flux_vals),
