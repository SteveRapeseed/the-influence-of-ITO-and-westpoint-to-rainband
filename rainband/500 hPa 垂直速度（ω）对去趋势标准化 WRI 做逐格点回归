def standardize_1d(x):
    x = np.asarray(x, dtype=float)
    return (x - np.nanmean(x)) / np.nanstd(x)


def read_wri_excel_auto(wri_file, year_start=1961, year_end=2020):
    xls = pd.ExcelFile(wri_file)
    best = None

    print("\nWRI Excel sheets:", xls.sheet_names)

    for sheet in xls.sheet_names:
        raw = pd.read_excel(wri_file, sheet_name=sheet, header=None)
        nrow, ncol = raw.shape

        for iy_col in range(ncol):

            year_num = pd.to_numeric(raw.iloc[:, iy_col], errors="coerce")

            year_like = (
                year_num.notna()
                & (year_num >= year_start)
                & (year_num <= year_end)
                & (np.abs(year_num - np.round(year_num)) < 1e-6)
            )

            if year_like.sum() < 20:
                continue

            for iw_col in range(ncol):

                if iw_col == iy_col:
                    continue

                wri_num = pd.to_numeric(raw.iloc[:, iw_col], errors="coerce")
                valid = year_like & wri_num.notna()

                if valid.sum() < 20:
                    continue

                tmp = pd.DataFrame({
                    "year": year_num[valid].astype(int).values,
                    "WRI": wri_num[valid].astype(float).values
                })

                tmp = tmp.drop_duplicates(subset=["year"], keep="first")
                tmp = tmp.sort_values("year").reset_index(drop=True)

                overlap_years = sorted(
                    list(
                        set(tmp["year"].values)
                        .intersection(set(np.arange(year_start, year_end + 1)))
                    )
                )

                score = len(overlap_years)

                first_valid_row = np.where(valid.values)[0][0]
                header_start = max(0, first_valid_row - 8)
                header_end = first_valid_row

                try:
                    header_cells = raw.iloc[header_start:header_end, iw_col].astype(str).values
                    header_text = " ".join(header_cells)
                except Exception:
                    header_text = ""

                header_lower = header_text.lower()

                if "wri_std" in header_lower:
                    score += 300
                elif "wri" in header_lower:
                    score += 200
                elif "index" in header_lower:
                    score += 50

                if ("lon" in header_lower) or ("longitude" in header_lower) or ("经度" in header_lower):
                    score -= 100

                candidate = {
                    "score": score,
                    "sheet": sheet,
                    "year_col": iy_col,
                    "wri_col": iw_col,
                    "data": tmp,
                    "header_text": header_text,
                }

                if best is None or candidate["score"] > best["score"]:
                    best = candidate

    if best is None:
        raise ValueError("没有在 WRI Excel 中找到可用的年份列和 WRI 数值列。")

    wri_df = best["data"].copy()

    print("\n========== WRI detected ==========")
    print("sheet:", best["sheet"])
    print("year_col:", best["year_col"])
    print("wri_col:", best["wri_col"])
    print("header:", best["header_text"])
    print(wri_df.head())
    print(wri_df.tail())

    return wri_df


def guess_coord_names_common(ds):
    names = list(ds.coords) + list(ds.dims)

    def find_one(candidates):
        for c in candidates:
            for n in names:
                if n.lower() == c.lower():
                    return n
        return None

    year_name = find_one(["year", "yr", "time_year"])
    pentad_name = find_one(["pentad", "pentads", "p"])
    level_name = find_one(["level", "lev", "plev", "pressure"])
    lat_name = find_one(["lat", "latitude"])
    lon_name = find_one(["lon", "longitude"])

    return year_name, pentad_name, level_name, lat_name, lon_name


def guess_precip_coord_names(ds):
    names = list(ds.coords) + list(ds.dims)

    def find_one(candidates):
        for c in candidates:
            for n in names:
                if n.lower() == c.lower():
                    return n
        return None

    year_name = find_one(["year", "yr", "time_year"])
    pentad_name = find_one(["pentad", "pentads", "p"])
    lat_name = find_one(["lat", "latitude"])
    lon_name = find_one(["lon", "longitude"])

    return year_name, pentad_name, lat_name, lon_name


def guess_var(ds, candidates):
    for c in candidates:
        if c in ds.data_vars:
            return c

    for v in ds.data_vars:
        vl = v.lower()
        for c in candidates:
            if c.lower() in vl:
                return v

    return None


def guess_precip_var(ds):
    candidates = ["pre", "precip", "precipitation", "pr", "rain", "rainfall"]

    for c in candidates:
        if c in ds.data_vars:
            return c

    for v in ds.data_vars:
        vl = v.lower()
        if any(c in vl for c in candidates):
            return v

    raise ValueError("没有自动识别出降水变量，请手动指定。")


def sort_latlon(da, lat_name, lon_name):
    if da[lat_name].values[0] > da[lat_name].values[-1]:
        da = da.sortby(lat_name)

    if da[lon_name].values[0] > da[lon_name].values[-1]:
        da = da.sortby(lon_name)

    return da


def detrend_3d_nan(y3d):
    y = np.asarray(y3d, dtype=float)
    nt = y.shape[0]

    t = np.arange(nt, dtype=float)
    t3 = t[:, None, None]

    mask = np.isfinite(y)

    n = np.sum(mask, axis=0)

    sum_t = np.sum(np.where(mask, t3, 0.0), axis=0)
    sum_y = np.sum(np.where(mask, y, 0.0), axis=0)
    sum_tt = np.sum(np.where(mask, t3 ** 2, 0.0), axis=0)
    sum_ty = np.sum(np.where(mask, t3 * y, 0.0), axis=0)

    den = n * sum_tt - sum_t ** 2

    slope = np.full(y.shape[1:], np.nan)
    intercept = np.full(y.shape[1:], np.nan)

    valid = (n >= 3) & np.isfinite(den) & (np.abs(den) > 1e-12)

    slope[valid] = (
        n[valid] * sum_ty[valid] - sum_t[valid] * sum_y[valid]
    ) / den[valid]

    intercept[valid] = (
        sum_y[valid] - slope[valid] * sum_t[valid]
    ) / n[valid]

    trend = intercept[None, :, :] + slope[None, :, :] * t3

    out = y - trend
    out[~mask] = np.nan

    return out


def regress_grid(y3d, x1d):
    y = np.asarray(y3d, dtype=float)
    x = np.asarray(x1d, dtype=float)

    if y.shape[0] != x.shape[0]:
        raise ValueError(f"y3d 时间长度 {y.shape[0]} 与 x1d 长度 {x.shape[0]} 不一致。")

    x3 = x[:, None, None]

    mask = np.isfinite(y) & np.isfinite(x3)

    n = np.sum(mask, axis=0)

    sum_x = np.sum(np.where(mask, x3, 0.0), axis=0)
    sum_y = np.sum(np.where(mask, y, 0.0), axis=0)

    sum_xx = np.sum(np.where(mask, x3 ** 2, 0.0), axis=0)
    sum_yy = np.sum(np.where(mask, y ** 2, 0.0), axis=0)
    sum_xy = np.sum(np.where(mask, x3 * y, 0.0), axis=0)

    with np.errstate(invalid="ignore", divide="ignore"):
        ssxx = sum_xx - sum_x ** 2 / n
        ssyy = sum_yy - sum_y ** 2 / n
        ssxy = sum_xy - sum_x * sum_y / n

    beta = np.full(y.shape[1:], np.nan)
    r = np.full(y.shape[1:], np.nan)
    p = np.full(y.shape[1:], np.nan)

    valid = (
        (n >= 5)
        & np.isfinite(ssxx)
        & np.isfinite(ssyy)
        & np.isfinite(ssxy)
        & (ssxx > 0)
        & (ssyy > 0)
    )

    beta[valid] = ssxy[valid] / ssxx[valid]

    r[valid] = ssxy[valid] / np.sqrt(ssxx[valid] * ssyy[valid])
    r = np.clip(r, -0.999999, 0.999999)

    df = n - 2

    tval = np.full(y.shape[1:], np.nan)
    tval[valid] = r[valid] * np.sqrt(df[valid] / (1.0 - r[valid] ** 2))

    p[valid] = 2.0 * t_dist.sf(np.abs(tval[valid]), df[valid])

    return beta, r, p


def smooth_field(field, sigma=0.75):
    out = np.asarray(field, dtype=float).copy()
    valid = np.isfinite(out)

    if valid.sum() == 0:
        return out

    fill_value = np.nanmean(out)
    tmp = np.where(valid, out, fill_value)
    sm = gaussian_filter(tmp, sigma=sigma)
    sm[~valid] = np.nan

    return sm


def add_china_boundary(ax):
    if os.path.exists(CHINA_SHP_PATH):
        reader = shapereader.Reader(CHINA_SHP_PATH)
        geoms = list(reader.geometries())

        ax.add_geometries(
            geoms,
            crs=proj,
            facecolor="none",
            edgecolor=PALETTE["line_dark"],
            linewidth=0.42,
            zorder=20
        )


def add_region_boxes(ax, add_label=True):
    label_pos = {
        "NW": (95.6, 38.85),
        "NC": (110.6, 42.25),
        "NE": (118.8, 53.85),
    }

    for name, box in REGION_BOXES.items():
        lon_min, lon_max, lat_min, lat_max = box

        rect = Rectangle(
            (lon_min, lat_min),
            lon_max - lon_min,
            lat_max - lat_min,
            linewidth=0.60,
            edgecolor=PALETTE["region"],
            facecolor="none",
            linestyle=(0, (4, 2.2)),
            alpha=0.82,
            transform=proj,
            zorder=30
        )

        ax.add_patch(rect)

        if add_label:
            x_text, y_text = label_pos[name]

            ax.text(
                x_text,
                y_text,
                name,
                fontsize=7.4,
                fontweight="bold",
                color=PALETTE["line_dark"],
                ha="left",
                va="top",
                transform=proj,
                zorder=31
            )


def setup_map(ax, add_region_label=True):
    ax.set_extent(MAP_EXTENT, crs=proj)

    add_china_boundary(ax)
    add_region_boxes(ax, add_label=add_region_label)

    xticks = np.arange(90, 141, 10)
    yticks = np.arange(25, 56, 5)

    ax.set_xticks(xticks, crs=proj)
    ax.set_yticks(yticks, crs=proj)

