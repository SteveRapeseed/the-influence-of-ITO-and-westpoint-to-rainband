for i, (ax, panel_letter, group_key) in enumerate(
    zip(axes, panel_letters, PENTAD_GROUPS.keys())
):

    setup_map(
        ax,
        add_region_label=True
    )

    omega_beta_scaled = plot_data[group_key]["omega_beta_scaled"]
    omega_p = plot_data[group_key]["omega_p"]
    pre_beta = plot_data[group_key]["pre_beta"]

    if SMOOTH_FIELD:
        omega_plot = smooth_field(omega_beta_scaled, sigma=SMOOTH_SIGMA)
    else:
        omega_plot = omega_beta_scaled

    cf = ax.contourf(
        omega_lons,
        omega_lats,
        omega_plot,
        levels=OMEGA_LEVELS,
        cmap=omega_cmap,
        extend="both",
        transform=proj,
        zorder=1
    )

    try:
        ax.contour(
            omega_lons,
            omega_lats,
            omega_plot,
            levels=[0],
            colors=PALETTE["line_mid"],
            linewidths=0.50,
            transform=proj,
            zorder=5
        )
    except Exception:
        pass

    sig = omega_p < SIG_P_LEVEL

    ax.scatter(
        lon2d_omega[::SIG_SKIP, ::SIG_SKIP][sig[::SIG_SKIP, ::SIG_SKIP]],
        lat2d_omega[::SIG_SKIP, ::SIG_SKIP][sig[::SIG_SKIP, ::SIG_SKIP]],
        s=0.40,
        color=PALETTE["line_dark"],
        alpha=0.12,
        linewidths=0,
        transform=proj,
        zorder=7
    )

    try:
        ax.contour(
            pre_lons,
            pre_lats,
            pre_beta,
            levels=[PRECIP_CORE_LEVEL],
            colors=PALETTE["line_mid"],
            linewidths=0.70,
            linestyles=(0, (3.2, 2.0)),
            transform=proj,
            zorder=8
        )
    except Exception:
        pass

    ax.set_title(
        f"({panel_letter}) {PENTAD_LABELS[group_key]}",
        loc="left",
        fontsize=10.4,
        fontweight="bold",
        pad=7,
        color=PALETTE["line_dark"],
        x=0.010
    )


fig.subplots_adjust(
    left=0.055,
    right=0.865,
    top=0.900,
    bottom=0.165,
    wspace=0.150
)

cax = fig.add_axes([0.885, 0.250, 0.010, 0.500])

cbar = fig.colorbar(
    cf,
    cax=cax,
    orientation="vertical",
    ticks=OMEGA_TICKS
)

cbar.ax.tick_params(labelsize=8.0, width=0.60, length=2.6, pad=2)
cbar.outline.set_linewidth(0.60)

cbar.set_label(
    "500 hPa vertical velocity regression\n"
    r"($10^{-2}$ Pa s$^{-1}$ per 1σ WRI)",
    fontsize=8.6,
    labelpad=6
)


